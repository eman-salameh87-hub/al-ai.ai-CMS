<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for running this Next.js app on SmarterASP.NET.

  HOW IT WORKS
  SmarterASP runs Node through IIS's httpPlatformHandler: IIS starts
  `node server.js`, hands it a private port in %HTTP_PLATFORM_PORT%, and
  reverse-proxies every request to it. Next.js standalone output produces
  exactly that `server.js` and already reads `process.env.PORT`, so the two
  fit together with no adapter.

  Restarts and crashes are IIS's problem, not yours — httpPlatformHandler
  relaunches the process. That is what replaces the `restartPolicy` in
  railway.json.

  SECRETS
  The values below are real secrets. IIS refuses to serve *.config over HTTP,
  so they are not readable from the web — but anyone with FTP or panel access
  can read them, which is the same exposure as any other file you upload.
  Rotate them if that access changes hands.
-->
<configuration>
  <system.webServer>

    <handlers>
      <!-- Every request goes to Node. Remove the inherited handlers first, or
           IIS tries to serve .js files as static content and the app never
           starts. -->
      <clear />
      <add name="httpPlatformHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified" />
    </handlers>

    <httpPlatform processPath="node"
                  arguments="server.js"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\node"
                  startupTimeLimit="120"
                  requestTimeout="00:04:00">
      <!--
        startupTimeLimit is 120s rather than the 20s default: a cold Next.js
        start has to open a database pool before it answers, and IIS killing it
        at 20 seconds looks exactly like a broken deploy.
      -->
      <environmentVariables>

        <!-- Required by httpPlatformHandler. Next's server.js reads PORT. -->
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />

        <!-- ─── FILL THESE IN ─────────────────────────────────────────
             Everything below is required; the app refuses to boot without
             them, deliberately. See lib/env.ts.
        -->

        <!-- From the SmarterASP panel: Database → PostgreSQL → connection string.
             Format: postgresql://user:password@host:5432/dbname -->
        <environmentVariable name="DATABASE_URL" value="REPLACE_ME" />

        <!-- Two DIFFERENT random strings, 32+ chars each.
             Generate with: openssl rand -base64 32 -->
        <environmentVariable name="JWT_ACCESS_SECRET" value="REPLACE_ME" />
        <environmentVariable name="JWT_REFRESH_SECRET" value="REPLACE_ME" />

        <!-- The live domain. This is also baked in at BUILD time — see
             deploy/smarterasp/README.md. It must match what you built with. -->
        <environmentVariable name="NEXT_PUBLIC_APP_URL" value="https://new-aeon.com" />

        <environmentVariable name="DEFAULT_LOCALE" value="ar" />
        <environmentVariable name="AVAILABLE_LOCALES" value="ar,en" />

        <!--
          Local disk, not S3.

          SmarterASP gives you a persistent filesystem, which a container host
          does not — so uploads survive restarts here and there is no reason to
          pay for object storage. UPLOAD_DIR is relative to the site root.
        -->
        <environmentVariable name="STORAGE_DRIVER" value="local" />
        <environmentVariable name="UPLOAD_DIR" value=".\public\uploads" />

        <!-- Mail. Use the SMTP details from the panel, or an external sender.
             MAIL_DRIVER=log writes to the stdout log instead of sending, which
             is a safe first deploy. -->
        <environmentVariable name="MAIL_DRIVER" value="smtp" />
        <environmentVariable name="SMTP_HOST" value="REPLACE_ME" />
        <environmentVariable name="SMTP_PORT" value="587" />
        <environmentVariable name="SMTP_USER" value="REPLACE_ME" />
        <environmentVariable name="SMTP_PASSWORD" value="REPLACE_ME" />
        <environmentVariable name="SMTP_SECURE" value="false" />
        <environmentVariable name="MAIL_FROM" value="info@new-aeon.com" />
        <environmentVariable name="MAIL_FROM_NAME" value="New Aeon" />

        <!-- Where contact-form and application notifications are sent. -->
        <environmentVariable name="MAIL_ADMIN_TO" value="info@new-aeon.com" />

      </environmentVariables>
    </httpPlatform>

    <!--
      The legacy site's own rewrite rules are NOT carried over.

      All 241 legacy URLs are handled inside the app by
      lib/redirects/legacy-map.ts, which runs in middleware before anything
      else. Adding IIS-level rewrites on top would double-redirect and make the
      two sets of rules disagree the first time either changes.
    -->

    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
